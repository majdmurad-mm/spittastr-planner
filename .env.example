# Copy to `.env` and fill in from your Supabase project:
#   Dashboard -> Project Settings -> API
#
# Both values are safe to ship in the built page — the publishable key is
# designed to be public and is constrained by the RLS policies in
# supabase/setup.sql. Never put the service_role / secret key here: it bypasses
# RLS entirely.
#
# Vite inlines these at build time, so re-run `npm run deploy` after changing them.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx
